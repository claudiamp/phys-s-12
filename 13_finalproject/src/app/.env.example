# Copy to app/.env and fill in. These are read at build time by app.config.js
# and surfaced to JS via expo-constants `extra` (see src/config.ts).
#
# The SAM stack's ApiBaseUrl output, e.g. https://abc123.execute-api.us-east-1.amazonaws.com/Prod
EXPO_PUBLIC_API_BASE_URL=
# The same secret passed to the backend ApiKey parameter (sent as the x-api-key header).
EXPO_PUBLIC_API_KEY=
