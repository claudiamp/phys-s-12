# Copy to .env and adjust. .env is gitignored.

# Where the plotter is. The name comes from MDNS_NAME in the firmware's
# secrets.h. If mDNS is being filtered on the network, paste the IP the board
# printed to serial instead -- that is the whole reason this is a setting.
PLOTTER_HOST=plotter.local

# Folder the console offers .gcode files from. Phase 2 replaces this with jobs
# generated from a photo.
GCODE_DIR=../../src/output

PORT=5050

# Measured travel of the machine, in mm. Must match BED_W_MM / BED_H_MM in the
# firmware -- runFile() aborts a job that moves outside those.
MACHINE_MM=350x250

# Where the usable area starts. The bottom 25mm of Y are skipped for
# calibration; the head can still be jogged there, nothing is drawn there.
ORIGIN_MM=0x25

# Size of one drawing. 350x220 usable / 100x100 = 3 across, 2 up = 6 per sheet.
BED_MM=100x100

# Blank space between drawings so there is room to cut them apart, in mm.
# X only by default; the G-code's own 5mm margin already gives 10mm between
# neighbours, and this is on top of that.
GAP_MM=20x20
